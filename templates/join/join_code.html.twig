{% extends 'base.html.twig' %}

{% block title %}Rejoindre un groupe - Kopeck{% endblock %}

{% block body %}
    <main class="container-md splitterForm join-code-page" {{ stimulus_controller('share-code') }}>

        <div class="d-flex align-items-center justify-content-between mb-4">
            <a class="nav-link" href="{{ path('app_home') }}" title="Retour home">
                <twig:ux:icon name="ep:back" height="30" width="30"/>
            </a>
            <div class="text-center flex-fill">
                <twig:ux:icon name="heroicons:user-plus" height="64" width="64" class="text-primary mb-3"/>
                <h1 class="h2 mb-0">Rejoindre un groupe</h1>
            </div>
            <div style="width: 30px;"></div> <!-- Espaceur pour équilibrer -->
        </div>

        <div class="justify-content-center">

                <div class="card shadow-sm">
                    <div class="card-body">
                        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true, 'data-share-code-target': 'form'}}) }}

                        <div class="mb-4">
                            {{ form_label(form.code, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.code, {'attr': {
                                'class': 'form-control form-control-lg text-center code-input',
                                'style': 'font-size: 1.5rem;',
                                'data-share-code-target': 'codeInput',
                                'data-action': 'input->share-code#formatCode keyup->share-code#checkAutoSubmit'
                            }}) }}
                            <div class="form-text text-adaptive">
                                <twig:ux:icon name="heroicons:information-circle" height="16" width="16" class="me-1"/>
                                Le code est composé de 6 chiffres
                            </div>
                            {{ form_errors(form.code) }}
                        </div>

                        <div class="d-grid">
                            {{ form_widget(form.submit, {'attr': {'class': 'btn btn-primary btn-lg'}}) }}
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>

                <div class="text-center mt-4">
                    <div class="card border-0 info-card">
                        <div class="card-body py-3">
                            <h6 class="card-title mb-2">
                                <twig:ux:icon name="heroicons:question-mark-circle" height="20" width="20" class="me-2"/>
                                Comment ça marche ?
                            </h6>
                            <small class="text-muted">
                                Demandez à la personne qui souhaite vous inviter de générer un code de partage
                                depuis son groupe. Le code expire après 1 heure et ne peut être utilisé qu'une seule fois.
                            </small>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-3">
                    <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
                        <twig:ux:icon name="ep:back" height="16" width="16" class="me-2"/>
                        Retour à l'accueil
                    </a>
                </div>
        </div>
    </main>

{% endblock %}
