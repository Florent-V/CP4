<nav
        {{ stimulus_controller('uiToggles') }}
        class="side-panel navbar navbar-expand-lg py-4 align-items-lg-start"
>
    <div class="container-fluid flex-lg-column">
        <img src="{{ asset('/images/mainlogo1.png') }}" alt="">
        <a class="navbar-brand m-0" href="{{ path('app_home') }}"><h1>Kopeck !</h1></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"><span></span></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <div class="d-flex flex-column align-items-center">
                <div class="info-user my-2">
                    <img src="{{ user.picture ? vich_uploader_asset(user, 'pictureFile') : asset('images/profil/Default_Profile_Picture.png') }}" alt="{% if user.picture %}Photo de profil{% else %}Photo de profil par défaut{% endif %}">
                    <p class="text-center m-0 mx-2" >Bienvenue <br>
                        {{ user.pseudo ?? 'Admin' }}
                    </p>
                    <a class="nav-link link-profile" href="{{ path('app_user_account') }}" title="Accéder à mon compte"></a>
                </div>
                <div class="d-flex justify-content-between align-items-center mt-3 mb-2 gap-3">
                    <h2 class="m-0">Mes groupes </h2>
                    <div id="sideAddSplitterBtn">
                        <a class="btn btn-primary rounded-circle" href="{{ path('app_splitter_new') }}">
                            <i class="bi bi-plus-lg"></i>
                        </a>
                    </div>
                </div>
                <ul class="navbar-nav flex-lg-column">
                    {% for split in splitters %}
                        <li class="nav-item d-flex align-items-center">
                            <a class="nav-link" aria-current="page" href="{{ path('app_splitter_show', {id: split.id}) }}">
                                {{ split.name }}
                            </a>
                            {% if split.owner == user.appUser %}
                                <a class="link-info" href="{{ path('app_splitter_edit', {id: split.id}) }}">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
                <a class="nav-link my-3" href="{{ path('app_join_with_code') }}">
                    <twig:ux:icon name="line-md:log-in" height="24" width="24" class="me-2"/>
                    Rejoindre avec un code
                </a>
                <!-- Dark/Light mode toggle -->
                <div class="d-flex gap-2 my-2">
                    <button id="theme-toggle" class="btn btn-outline-secondary d-flex align-items-center" type="button" title="Changer de thème">
                        <i id="theme-icon" class="bi bi-moon"></i>
                    </button>
                    <!-- Simple/Complet mode toggle -->
                    <button id="mode-toggle" class="btn btn-outline-secondary d-flex align-items-center" type="button" title="Basculer mode simple/complet">
                        <i id="mode-icon" class="bi bi-list"></i>
                    </button>
                    <a class="btn btn-outline-danger d-flex align-items-center"  href="{{ path('app_logout') }}">
                        <twig:ux:icon name="streamline:interface-logout-arrow-exit-frame-leave-logout-rectangle-right" height="20" width="20" color="#f43f5e" />
                    </a>
                </div>
            </div>
        </div>
    </div>
</nav>
