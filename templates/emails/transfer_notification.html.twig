<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notification de Transfert</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f7f9fb;
            color: #23272f;
        }
        .container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }
        .header {
            background: linear-gradient(135deg, #38c6a6 0%, #2a9c82 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }
        .header h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 600;
        }
        .content {
            padding: 40px 30px;
        }
        .transfer-card {
            background: #f7f9fb;
            border: 2px solid #e4ecfa;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
        }
        .transfer-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        .transfer-table td {
            padding: 8px 0;
            text-align: center;
        }
        .transfer-label {
            color: #888;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding-bottom: 5px;
        }
        .transfer-name {
            color: #3a8dde;
            font-size: 20px;
            font-weight: 700;
            padding: 10px 20px;
            background: #ffffff;
            border-radius: 6px;
            display: inline-block;
            margin: 5px 0;
        }
        .transfer-separator {
            color: #ccc;
            font-size: 24px;
            padding: 0 15px;
        }
        .amount {
            text-align: center;
            font-size: 32px;
            font-weight: 700;
            color: #38c6a6;
            margin: 20px 0;
        }
        .transfer-details {
            font-size: 16px;
            line-height: 1.6;
            color: #666;
        }
        .transfer-details strong {
            color: #333;
        }
        .footer {
            background: #f8f9fa;
            padding: 20px 30px;
            text-align: center;
            color: #666;
            font-size: 14px;
            border-top: 1px solid #e4ecfa;
        }
        .emoji {
            font-size: 1.2em;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h1>
            {% if action == 'created' %}
                <span class="emoji">💸</span> Nouveau Transfert
            {% elseif action == 'updated' %}
                <span class="emoji">🔄</span> Transfert Mis à Jour
            {% else %}
                <span class="emoji">🗑️</span> Transfert Supprimé
            {% endif %}
        </h1>
    </div>

    <div class="content">
        <p>Bonjour,</p>

        <p>
            Un transfert d'argent a été
            {% if action == 'created' %}
                enregistré
            {% elseif action == 'updated' %}
                mis à jour
            {% else %}
                supprimé
            {% endif %}
            dans le groupe <strong>{{ splitter.name }}</strong>.
        </p>

        <div class="transfer-card">
            <table class="transfer-table" cellpadding="0" cellspacing="0">
                <tr>
                    <td style="width: 45%;">
                        <div class="transfer-label">De</div>
                        <div class="transfer-name">{{ transfer.fromMember.nickname }}</div>
                    </td>
                    <td style="width: 10%;">
                        <div class="transfer-separator">→</div>
                    </td>
                    <td style="width: 45%;">
                        <div class="transfer-label">À</div>
                        <div class="transfer-name">{{ transfer.toMember.nickname }}</div>
                    </td>
                </tr>
            </table>

            <div class="amount">
                {{ transfer.amount|round(2) }} €
            </div>

            <div class="transfer-details">
                <strong>Date :</strong> {{ transfer.madeAt|date('d/m/Y') }}<br>
                {% if transfer.description %}
                    <strong>Description :</strong> {{ transfer.description }}<br>
                {% endif %}
                <strong>Enregistré par :</strong> {{ transfer.addedBy.user.firstName }} {{ transfer.addedBy.user.lastName }}
            </div>
        </div>

        <p>
            {% if action == 'created' %}
                <strong>{{ transfer.fromMember.nickname }}</strong> a remboursé <strong>{{ transfer.toMember.nickname }}</strong>.
            {% endif %}
        </p>

        <p style="color: #666; font-size: 14px;">
            Vous recevez cet email car vous êtes membre du groupe {{ splitter.name }}.
        </p>
    </div>

    <div class="footer">
        <p>Cet email a été envoyé automatiquement depuis votre application Kopeck.</p>
    </div>
</div>
</body>
</html>

