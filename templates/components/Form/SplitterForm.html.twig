<div {{ attributes }}>
    {{ form_start(form) }}

    {{ form_errors(form) }}

    {{ form_row(form.name, {
        row_attr: {
            class: 'form-floating mb-3'
        }
    }) }}

    {{ form_row(form.description, {
        row_attr: {
            class: 'form-floating mb-3'
        }
    }) }}

    {{ form_row(form.category, {
        row_attr: {
            class: 'form-floating mb-3'
        }
    }) }}

    <p>Ajouter des membres</p>

        {% for key, member_form in form.members %}
            {% set my_label = (key == 0) ? 'Votre Nom' : 'Autre Participant' %}
            {% set nickname = (key == 0) ? app.user.firstName : (member_form.vars.value ? member_form.vars.value.nickname : '') %}

            <div class="d-flex gap-2 align-items-center">
                {{ form_row(member_form.nickname, {
                    label: my_label,
                    row_attr: {
                        class: 'form-floating mb-3 flex-grow-1'
                    },
                    attr: {
                        placeholder: 'Pseudo',
                        value: nickname
                    }
                }) }}

                {%  if my_label != 'Votre Nom' %}
                    {{ form_row(member_form.vars.button_delete, {
                        label: false,
                        row_attr: {
                            class: 'mb-3'
                        },
                        attr: {
                            class: 'btn btn-danger p-2 corbeille bi bi-trash',
                        }
                    }) }}
                {% endif %}

            </div>

        {% endfor %}

    {{ form_errors(form.members) }}
    {{ form_widget(form.members.vars.button_add, {label: '+ Ajouter un membre', attr: {class: 'btn btn-outline-primary plus-btn'}}) }}

    <div class="centerBtn mt-4">
        <button type="submit" class="btn btn-success valid-btn" formnovalidate>{{ this.buttonLabel|default('Créer') }}</button>
    </div>

    {{ form_end(form) }}
</div>
