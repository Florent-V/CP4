<form
        title= {{ this.title }}
        method="post"
        action="{{ path(this.route, {splitter_id: this.id, expense_id: this.id2}) }}"
        onsubmit="return confirm('Are you sure you want to delete this {{ entity }}?');"
>
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ this.id) }}">

        <button class="dropdown-item btn btn-icon p-0 d-flex gap-2">
            <twig:ux:icon name="mdi:trash-can-outline" height="24" width="24" />
            {% if this.label %}
                <span>{{ this.label }}</span>
            {% endif %}
        </button>

</form>
