{{ form_start(form) }}

    <div class="mb-3" data-controller="custom-file-input">
        <div class="d-flex align-items-stretch">
            <div class="form-floating flex-grow-1">
                {{ form_widget(form.name, {
                    attr: {
                        placeholder: 'Titre',
                    }
                }) }}
                {{ form_label(form.name, 'Titre') }}
            </div>
            <div class="ms-2">
                {{ form_widget(form.pictureFile.file, {
                    'attr': {
                        'data-custom-file-input-target': 'input',
                        'class': 'd-none'
                    }
                }) }}
                <label for="{{ form.pictureFile.file.vars.id }}" class="btn btn-secondary h-100 d-flex align-items-center justify-content-center" data-action="click->custom-file-input#open">
                    <twig:ux:icon name="mdi:camera" height="24" width="24" />
                </label>
            </div>
        </div>
        <div class="d-flex">
            <div class="flex-grow-1">
                {{ form_errors(form.name) }}
            </div>
            <div class="ms-2" style="width: 48px;"></div>
        </div>
        <div class="mt-1">
            <span data-custom-file-input-target="fileName" class="ms-1"></span>
            {{ form_errors(form.pictureFile) }}
            <div class="form-text">
                {{ form_help(form.pictureFile) }}
            </div>
        </div>
        {% if expense is defined and expense.picture %}
            <div class="mt-2">
                <img
                    src="{{ vich_uploader_asset(expense, 'pictureFile') }}"
                    alt="Photo actuelle"
                    style="max-width: 100%; height: auto; border-radius: 8px;"
                >
                <div class="form-check mt-2">
                    {{ form_widget(form.pictureFile.delete) }}
                    {{ form_label(form.pictureFile.delete, 'Supprimer la photo') }}
                </div>
            </div>
        {% else %}
            <div style="display: none;">
                {{ form_widget(form.pictureFile.delete) }}
            </div>
        {% endif %}
    </div>

    {{ form_row(form.madeAt, {
        label: 'Date',
        attr: {
            placeholder: '2023-12-31',
        },
        row_attr: {
            class: 'form-floating mb-3'
        }
    }) }}

    <div class="input-group mb-3">
        <div class="form-floating flex-grow-1">
            {{ form_widget(form.amount) }}
            {{ form_label(form.amount, 'Montant') }}
        </div>
        <div class="input-group-text btn btn-secondary btn-square d-flex justify-content-center align-items-center">
            <twig:ux:icon name="material-symbols:euro" height="24" width="24"/>
        </div>
    </div>
    {{ form_errors(form.amount) }}

    {{ form_row(form.paidBy, {
        label: 'Payé par :',
        attr: {
            placeholder: 'John Doe',
        },
        row_attr: {
            class: 'form-floating mb-3'
        }
    }) }}

    {{ form_row(form.category, {
        label: 'Catégorie',
        attr: {
            placeholder: 'Alimentaiton',
        },
        row_attr: {
            class: 'form-floating mb-3'
        }
    }) }}

    {{ form_row(form.beneficiaries, {
        label: 'Bénéficiaires :',
        attr: {
            placeholder: 'Alimentaiton',
        },
        row_attr: {
            class: 'mb-3'
        }
    }) }}


    <div class="centerBtn">
        <button class="btn btn-success valid-btn">{{ button_label|default('Ajouter') }}</button>
    </div>
{{ form_end(form) }}
