{{ form_start(form, {attr: {
    'data-controller': 'expense-share',
    'data-action': 'submit->expense-share#onSubmit',
}}) }}

    <div class="mb-3" data-controller="custom-file-input">
        <div class="d-flex align-items-stretch">
            <div class="form-floating flex-grow-1">
                {{ form_widget(form.name, {
                    attr: {placeholder: 'Titre'},
                }) }}
                {{ form_label(form.name, 'Titre') }}
            </div>
            <div class="ms-2">
                {{ form_widget(form.pictureFile, {
                    attr: {
                        'data-custom-file-input-target': 'input',
                        class: 'd-none',
                    },
                }) }}
                <label for="{{ form.pictureFile.vars.id }}" class="btn btn-secondary h-100 d-flex align-items-center justify-content-center" data-action="click->custom-file-input#open">
                    <twig:ux:icon name="mdi:camera" height="24" width="24" />
                </label>
            </div>
        </div>
        <div class="d-flex">
            <div class="flex-grow-1">{{ form_errors(form.name) }}</div>
            <div class="ms-2" style="width: 48px;"></div>
        </div>
        <div class="mt-1">
            <span data-custom-file-input-target="fileName" class="ms-1"></span>
            {{ form_errors(form.pictureFile) }}
            <div class="form-text">{{ form_help(form.pictureFile) }}</div>
        </div>
    </div>

    {{ form_row(form.madeAt, {
        label: 'Date',
        attr: {placeholder: '2023-12-31'},
        row_attr: {class: 'form-floating mb-3'},
    }) }}

    <div class="mb-3">
        <div class="input-group">
            <div class="form-floating flex-grow-1">
                {{ form_widget(form.amount, {attr: {
                    'data-expense-share-target': 'amount',
                    'data-action': 'input->expense-share#onAmountInput',
                }}) }}
                {{ form_label(form.amount, 'Montant') }}
            </div>
            <div class="input-group-text btn btn-secondary btn-square d-flex justify-content-center align-items-center">
                <twig:ux:icon name="material-symbols:euro" height="24" width="24"/>
            </div>
        </div>
        {{ form_errors(form.amount) }}
    </div>

    {{ form_row(form.paidBy, {
        label: 'Payé par :',
        row_attr: {class: 'form-floating mb-3'},
    }) }}

    {{ form_row(form.category, {
        label: 'Catégorie',
        row_attr: {class: 'form-floating mb-3'},
    }) }}

    {# Bénéficiaires #}
    <div
        class="mb-3"
        data-expense-share-target="beneficiaries"
        data-action="change->expense-share#onBeneficiaryChange"
    >
        {{ form_label(form.beneficiaries, 'Bénéficiaires :') }}
        {{ form_widget(form.beneficiaries) }}
        {{ form_errors(form.beneficiaries) }}
    </div>

    {# Répartition #}
    <div class="mb-3">
        {{ form_label(form.splitType) }}
        {{ form_widget(form.splitType, {attr: {
            'data-expense-share-target': 'splitType',
            'data-action': 'change->expense-share#onSplitTypeChange',
        }}) }}
        {{ form_errors(form.splitType) }}
    </div>

    {# Section shares — cachée par défaut en mode égalité #}
    <div
        data-expense-share-target="sharesSection"
        class="mb-3{% if form.splitType.vars.data is null or form.splitType.vars.data.value == 'equal' %} d-none{% endif %}"
    >
        <div class="card">
            <div class="card-body">
                <h6 class="card-title mb-3">Répartition par bénéficiaire</h6>

                <div
                    data-expense-share-target="sharesCollection"
                    data-index="{{ form.shares|length }}"
                    data-prototype="{{ form_widget(form.shares.vars.prototype)|e('html_attr') }}"
                    data-action="input->expense-share#onShareInput"
                >
                    {% for share_form in form.shares %}
                        {% set member = share_form.vars.data.member %}
                        <div
                            class="js-share-row mb-2"
                            data-member-id="{{ member.id }}"
                        >
                            <div class="d-flex align-items-center gap-2">
                                <span class="fw-medium" style="min-width: 100px;">
                                    {{ member.nickname }}
                                </span>
                                {{ form_widget(share_form.member, {attr: {class: 'd-none'}}) }}
                                {{ form_widget(share_form.share, {attr: {class: 'form-control form-control-sm js-share-input'}}) }}
                                <span class="js-share-unit text-muted">
                                    {{ form.splitType.vars.data.value == 'percentage' ? '%' : '€' }}
                                </span>
                            </div>
                            {{ form_errors(share_form.share) }}
                        </div>
                    {% endfor %}
                </div>

                <div class="d-flex justify-content-end align-items-center gap-2 mt-2">
                    <span class="text-muted small" data-expense-share-target="sumDisplay"></span>
                    <span class="badge" data-expense-share-target="sumStatus"></span>
                </div>

                {{ form_errors(form.shares) }}
                {{ form_errors(form) }}
            </div>
        </div>
    </div>

    <div class="centerBtn">
        <button class="btn btn-success valid-btn">{{ button_label|default('Ajouter') }}</button>
    </div>

{{ form_end(form) }}
