<form
        title= "Supprimer la dépense"
        method="post"
        action="{{ path('app_expense_delete', {'expense_id': expense.id, 'splitter_id': splitter.id}) }}"
        onsubmit="return confirm('Etes-vous sur de vouloir supprimer cette depense ?');"
>
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ expense.id) }}">
    <button class="dropdown-item btn btn-icon p-0 d-flex gap-2">
        <twig:ux:icon name="mdi:trash-can-outline" height="24" width="24" />
        <span>Supprimer</span>
    </button>
</form>
