{% extends 'base.html.twig' %}

{% block title %}Depense {{ expense.name }}{% endblock %}

{% block body %}

    <main
            class="expenseView container-md"
    >

        <div class="splitter-header d-flex justify-content-between align-items-center my-2">
            <a class="nav-link" href="{{ path('app_splitter_show', {id: expense.splitter.id}) }}" title="Retour home">
                <twig:ux:icon name="ep:back" height="24" width="24"/>
            </a>
            <div class="d-flex gap-3 align-items-center">
                <twig:ux:icon name="{{ expense.category.icon }}" height="50" width="50" aria-hidden="true" />
                <h1 class="splitter-title">{{ expense.name }}</h1>
            </div>
            <div class="dropdown action-menu">
                <button class="btn btn-icon p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <twig:ux:icon name="pepicons-pencil:dots-y" height="24" width="24"/>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    {% if splitter.owner == app.user.appUser or expense.addedBy == app.user.appUser %}
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" title="Editer la dépense"
                               href="{{ path('app_expense_edit', {expense_id: expense.id, splitter_id: splitter.id}) }}">
                                <twig:ux:icon name="ic:twotone-edit" height="24" width="24"/>
                                <span>Modifier</span>
                            </a>
                        </li>
                        <li>
                            <div style="cursor:pointer;" class="dropdown-item d-flex align-items-center gap-2">
                                {{ include('expense/_delete_form.html.twig') }}
                            </div>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
        <div class="expense-detail mb-4">
            <h2 class="expense-title">Informations de la dépense</h2>
            <div class="expense-info">
                <div class="info-item">
                    <p class="info-label">Payé par :</p>
                    <p class="info-value">{{ expense.paidBy.nickname }}</p>
                </div>
                <div class="info-item">
                    <p class="info-label">Le :</p>
                    <p class="info-value">{{ expense.madeAt|date('d/m/Y') }}</p>
                </div>
                <div class="info-item">
                    <p class="info-label">Catégorie :</p>
                    <p class="info-value">{{ expense.category.name }}</p>
                </div>
                <div class="info-item">
                    <p class="info-label">Montant :</p>
                    <p class="info-value">{{ expense.amount ~ ' ' ~ expense.devise }}</p>
                </div>
                <div class="info-item">
                    <p class="info-label"><i class="bi bi-person-fill"></i> Bénéficiaires :</p>
                    <p class="info-value">
                        {% for beneficiary in expense.beneficiaries %}
                            <span>{{ beneficiary.nickname }}</span>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </p>
                </div>
                <div class="info-item">
                    <p class="info-label">Répartition :</p>
                    <p class="info-value">
                        {% if expense.splitType.value == 'equal' %}
                            Égalité ({{ (expense.amount / expense.beneficiaries|length)|number_format(2) }}{{ expense.devise }} chacun)
                        {% elseif expense.splitType.value == 'percentage' %}
                            {% for share in expense.shares %}
                                <span>
                                    {{ share.member.nickname }} :
                                    {{ share.share|number_format(1) }}%
                                    ({{ (expense.amount * share.share / 100)|number_format(2) }}{{ expense.devise }})
                                </span>{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        {% else %}
                            {% for share in expense.shares %}
                                <span>{{ share.member.nickname }} : {{ share.share|number_format(2) }}{{ expense.devise }}</span>{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        {% endif %}
                    </p>
                </div>
                {% if expense.picture %}
                    <div class="info-item">
                        <p class="info-label">Photo :</p>
                        <p class="info-value">
                            <img
                                src="{{ vich_uploader_asset(expense, 'pictureFile') }}"
                                alt="Photo de la dépense"
                                class="expense-photo"
                                style="cursor: pointer;"
                                data-bs-toggle="modal"
                                data-bs-target="#expensePhotoModal"
                            >
                        </p>
                    </div>
                {% endif %}
            </div>
        </div>

    </main>

    {% if expense.picture %}
        <div class="modal fade" id="expensePhotoModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
                    <div class="modal-header" style="border: none; padding-bottom: 0;">
                        <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body text-center" style="padding-top: 0;">
                        <img
                            src="{{ vich_uploader_asset(expense, 'pictureFile') }}"
                            alt="Photo de la dépense"
                            style="max-width: 100%; height: auto; border-radius: 12px;"
                        >
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

{% endblock %}
