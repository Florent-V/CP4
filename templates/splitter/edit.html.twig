{% extends 'base.html.twig' %}

{% block title %}Modifier un groupe{% endblock %}

{% block body %}

    <main class="container-md splitterForm">

        <div class="d-flex align-items-center gap-3 mb-4">
            <a
                class="nav-link"
                href="{{ path('app_splitter_show', {'id': splitter.id}) }}"
                title="Retourner au groupe {{ splitter.name }}"
            >
                <twig:ux:icon name="ep:back" height="30" width="30"/>
            </a>
            <h1 class="text-center my-2">Modifier votre groupe</h1>
        </div>

        {{ component('Form:SplitterForm', {
            form: form,
            initialFormData: splitter,
            label: 'Modifier le Groupe',
        }) }}

    </main>

{% endblock %}
