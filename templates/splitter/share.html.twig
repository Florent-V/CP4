{% extends 'base.html.twig' %}

{% block title %}Kopeck !{% endblock %}

{% block body %}

    <main class="container-md">

        <div class="d-flex align-items-center gap-3 mb-4">
            <a class="nav-link" href="{{ path('app_splitter_show', {'id': splitter.id}) }}" title="Retour Groupe">
                <twig:ux:icon name="ep:back" height="30" width="30"/>
            </a>
            <h1 class="text-center my-2">Partager le groupe {{ splitter.name }}</h1>
        </div>




        <div class="d-flex justify-content-between align-items-center my-3">
            <h2 class="m-0">Saisir le mail de la personne que vous souhaitez inviter :</h2>
        </div>

        <div>
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="centerBtn">
                <button class="btn btn-primary">{{ button_label|default('Partager le groupe') }}</button>
            </div>

            {{ form_end(form) }}

        </div>



    </main>



{% endblock %}
