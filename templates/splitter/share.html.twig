{% extends 'base.html.twig' %}

{% block title %}Kopeck !{% endblock %}

{% block body %}

    <main class="container-md">

        <div class="d-flex align-items-center gap-3 mb-4">
            <a class="nav-link" href="{{ path('app_splitter_show', {'id': splitter.id}) }}" title="Retour Groupe">
                <twig:ux:icon name="ep:back" height="30" width="30"/>
            </a>
            <h1 class="text-center my-2">Partager le groupe {{ splitter.name }}</h1>
        </div>

        <div class="d-flex justify-content-between align-items-center my-3">
            <h2 class="m-0">Choisissez votre méthode de partage :</h2>
        </div>

        {# Partage par code #}
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <twig:ux:icon name="material-symbols:share" height="48" width="48" class="text-primary mb-3"/>
                        <h4 class="card-title">Partage par code</h4>
                        <p class="text-muted">Générez un code à 6 chiffres simple à partager</p>
                        <a href="{{ share_code_url(splitter) }}" class="btn btn-primary">
                            <twig:ux:icon name="streamline:qr-code" height="16" width="16" class="me-2"/>
                            Générer un code
                        </a>
                        <div class="mt-2">
                            <small class="text-muted">
                                <twig:ux:icon name="mdi-light:clock" height="14" width="14" class="me-1"/>
                                Expire en 1h • Usage unique
                            </small>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100">
                    <div class="card-body text-center">
                        <twig:ux:icon name="material-symbols:mail-outline-rounded" height="48" width="48" class="text-success mb-3"/>
                        <h4 class="card-title">Partage par email</h4>
                        <p class="text-muted">Envoyez une invitation directement par email</p>
                        <button class="btn btn-success" onclick="showEmailForm()">
                            <twig:ux:icon name="mingcute:send-plane-line" height="16" width="16" class="me-2"/>
                            Inviter par email
                        </button>
                        <div class="mt-2">
                            <small class="text-muted">
                                <twig:ux:icon name="ri:shield-check-line" height="14" width="14" class="me-1"/>
                                Invitation personnalisée
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Formulaire email (masqué par défaut) #}
        <div id="emailForm" class="d-none">
            <hr class="my-4">
            <h3>Invitation par email</h3>
            <p class="text-muted">Saisissez l'email de la personne que vous souhaitez inviter :</p>

            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="centerBtn">
                <button class="btn btn-success">{{ button_label|default('Envoyer l\'invitation') }}</button>
                <button type="button" class="btn btn-secondary ms-2" onclick="hideEmailForm()">Annuler</button>
            </div>
            {{ form_end(form) }}
        </div>

        <script>
            function showEmailForm() {
                document.getElementById('emailForm').classList.remove('d-none');
                document.querySelector('input[type="email"]')?.focus();
            }

            function hideEmailForm() {
                document.getElementById('emailForm').classList.add('d-none');
            }
        </script>

    </main>

{% endblock %}
