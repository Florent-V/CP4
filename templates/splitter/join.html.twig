{% extends 'base.html.twig' %}

{% block title %}Kopeck : Rejoindre un groupe{% endblock %}

{% block body %}

    <main class="container-md splitterForm">

        <div class="d-flex align-items-center gap-3 mb-4">
            <a class="nav-link" href="{{ path('app_home') }}" title="Retour home">
                <twig:ux:icon name="ep:back" height="30" width="30"/>
            </a>
            <h1 class="text-center my-2">Entrer le code ci-dessous pour rejoindre un groupe sur Kopeck !</h1>
        </div>

        <div>
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="centerBtn">
                <button type="submit" class="btn btn-success valid-btn">{{ button_label|default('Partager le groupe') }}</button>
            </div>

            {{ form_end(form) }}

        </div>



    </main>



{% endblock %}
