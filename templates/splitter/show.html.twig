{% extends 'base.html.twig' %}

{% block title %}Kopeck - Détail du groupe{% endblock %}

{% block body %}

    <main
        {{ stimulus_controller('splitterTabs') }}
        class="splitterView container-md"
    >

        <!-- Header : title + icons -->
        <div class="splitter-header d-flex justify-content-between align-items-center my-4">
            <a class="nav-link" href="{{ path('app_home') }}" title="Retour home">
                <twig:ux:icon name="ep:back" height="24" width="24"/>
            </a>
            <h1 class="splitter-title">{{ splitter.name }}</h1>
            <div class="dropdown action-menu">
                <button class="btn btn-icon p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <twig:ux:icon name="pepicons-pencil:dots-y" height="24" width="24"/>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow">
                    {% if not app.user or (splitter not in app.user.appUser.favoriteSplitters) %}
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" title="Rejoindre"
                               href="{{ path('app_splitter_join', {'id': splitter.id}) }}">
                                <i class="bi bi-pencil"></i> <span>Rejoindre</span>
                            </a>
                        </li>
                    {% endif %}
                    {% if app.user %}
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" title="Quitter le Splitter"
                               href="{{ path('app_splitter_leave', {'id': splitter.id}) }}">
                                <twig:ux:icon name="mingcute:exit-line" height="24" width="24"/>
                                <span>Quitter le groupe</span>
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" title="ajouter une dépense"
                               href="{{ path('app_expense_new', {'splitter_id': splitter.id}) }}">
                                <twig:ux:icon name="icon-park-twotone:add-web" height="24" width="24"/>
                                <span>Ajouter une dépense</span>
                            </a>
                        </li>
                        <li>
                            <div style="cursor:pointer;" class="dropdown-item d-flex align-items-center gap-2"
                                 data-bs-toggle="modal" data-bs-target="#shareModal">
                                <twig:ux:icon name="material-symbols:share-outline" height="24" width="24"/>
                                <span>Partager le groupe</span>
                            </div>
                        </li>
                        <li>
                            <a class="dropdown-item d-flex align-items-center gap-2" title="Voir historique"
                               href="{{ path('app_splitter_show_history', {'id': splitter.id}) }}">
                                <twig:ux:icon name="material-symbols:history-rounded" height="24" width="24"/>
                                <span>Historique</span>
                            </a>
                        </li>
                        {% if splitter.owner == app.user.appUser %}
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" title="Editer le splitter"
                                   href="{{ path('app_splitter_edit', {'id': splitter.id}) }}">
                                    <twig:ux:icon name="ic:twotone-edit" height="24" width="24"/>
                                    <span>Modifier</span>
                                </a>
                            </li>
                            <li>
                                <div style="cursor:pointer;" class="dropdown-item d-flex align-items-center gap-2">
                                    <twig:Form:DeleteForm
                                            entity='splitter'
                                            id='{{ splitter.id }}'
                                            title="Supprimer le groupe"
                                    />
                                    <span>Supprimer</span>

                                </div>
                            </li>
                        {% endif %}
                    {% endif %}
                </ul>
            </div>
        </div>

        {% if app.user %}
            <!-- Modal pour partage du groupe -->
            <div class="modal fade" id="shareModal" tabindex="-1" aria-labelledby="shareModalLabel"
                 aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div id="modal" class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5" id="shareModalLabel">Partagez votre groupe</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Fermer"></button>
                        </div>
                        <div class="modal-body d-flex flex-column justify-content-between gap-2"
                             data-controller="clipboard" data-clipboard-success-content-value="Copié !">
                            <input class="form-control" type="text"
                                   value="{{ url('app_splitter_guest_show', {'id': splitter.id, 'unique_id': splitter.uniqueId}) }}"
                                   data-clipboard-target="source" readonly>
                            <button type="button" class="btn btn-primary align-self-center" data-action="clipboard#copy"
                                    data-clipboard-target="button">Copier
                            </button>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                            <button type="button" class="btn btn-primary">
                                <a class="nav-link" href="{{ path('app_splitter_share', {'id': splitter.id}) }}"
                                   title="Partager par mail">Partager par Mail</a>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}

        <p class="splitter-members">
            Membres :
            {% for member in splitter.members %}
                {{ member.nickname }}{% if not loop.last %}, {% endif %}
            {% endfor %}
        </p>

        <p>Description : {{ splitter.description }}</p>


        <div class="custom-tabs mb-4">
            <div class="d-flex tab-header">
                <div class="flex-fill tab active" data-tab="depenses">Dépenses</div>
                <div class="flex-fill tab" data-tab="balances">Balances</div>
                <div class="flex-fill tab" data-tab="photos">Photos</div>
            </div>
            <div class="tab-content">
                <div id="depenses" class="tab-pane active">
                    <div class="expense-header">
                        <div class="total-user">Total des dépenses utilisateur: Soon... </div>
                        <div class="total-group">Total des dépenses groupe: {{ groupTotal }}€</div>
                    </div>

                    <div class="expense-list">
                        {% for date, expenses in expensesByDate %}
                            <div class="expense-date">
                                {{ date|date('d M Y') }}
                            </div>
                            {% for expense in expenses %}
                                <div class="expense-card d-flex justify-content-between align-items-center gap-4">
                                    <div>
                                        <twig:ux:icon name="{{ expense.category.icon }}" height="50" width="50"
                                                      aria-hidden="true"/>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="expense-title">{{ expense.name }}</div>
                                        <div class="expense-payer">Payé par: {{ expense.paidBy.nickname }}</div>
                                    </div>

                                    <div class="expense-amount">{{ expense.amount }} {{ expense.devise }}</div>
                                    <a class="linkExpense"
                                       href="{{ path(('app_expense_show'), {'expense_id': expense.id, 'splitter_id': splitter.id}) }}"
                                       title="Cliquer pour éditer"></a>
                                </div>
                            {% endfor %}
                        {% endfor %}
                    </div>

                </div>

                <div id="balances" class="tab-pane">
                    <div class="balance-list">
                        <div class="balance-subtitle">
                            Balances
                        </div>
                        {% for member in splitter.members %}
                            <div class="balance-card">
                                <div class="member-name">{{ member.nickname }}</div>
                                <div class="balance-amount">
                                    <span class="badge {{ balancePerId[member.id] < 0 ? 'bg-warning text-dark' : 'bg-success' }}">
                                        {{ balancePerId[member.id]|round(2) }}€
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="balance-list">
                        <div class="balance-subtitle">Régler les dettes !</div>
                        {% for transfer in transfers %}
                            <div class="balance-card">
                                <div>
                                    <span class="debt-from">{{ transfer['from'].nickname }}</span>
                                    doit
                                    <span class="debt-amount">{{ transfer['amount']|round(2) }}€</span>
                                    à
                                    <span class="debt-to">{{ transfer['to'].nickname }}</span>
                                </div>
                            </div>
                        {% endfor %}

                    </div>

                </div>
                <div id="photos" class="tab-pane">
                    <div class="photo-placeholder">
                        <!-- Placeholder pour les photos -->
                        <p>Les photos seront affichées ici.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="floating-add-button">
                <a class="add-button d-flex align-items-center gap-2" title="ajouter une dépense"
                   href="{{ path('app_expense_new', {'splitter_id': splitter.id}) }}">
                    <twig:ux:icon name="material-symbols:add-rounded" height="40" width="40"/>
                </a>
        </div>

    </main>

{% endblock %}