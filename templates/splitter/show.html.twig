        <div class="custom-tabs">
            <div class="d-flex tab-header">
                <div class="flex-fill tab factive" data-tab="depenses">Dépenses</div>
                <div class="flex-fill tab" data-tab="balances">Balances</div>
                <div class="flex-fill tab" data-tab="photos">Photos</div>
            </div>
            <div class="tab-content">
                <div id="depenses" class="tab-pane active">
                    <div class="expense-header">
                        <div class="total-user">Total des dépenses utilisateur: 100€</div>
                        <div class="total-group">Total des dépenses groupe: 500€</div>
                    </div>
                    <div class="expense-list">
                        <div class="expense-date">Janvier 2023</div>
                        <div class="expense-card">
                            <div class="expense-title">Titre de la dépense</div>
                            <div class="expense-payer">Payé par: Utilisateur</div>
                            <div class="expense-amount">100€</div>
                        </div>
                        <!-- Ajoutez d'autres cartes de dépenses ici -->
                    </div>
                </div>
                <div id="balances" class="tab-pane">
                    <div class="balance-list">
                        <div class="balance-card">
                            <div class="member-name">Utilisateur 1</div>
                            <div class="balance-amount">100€</div>
                        </div>
                        <!-- Ajoutez d'autres cartes de balance ici -->
                    </div>
                    <div class="settle-debts">
                        <div class="card mb-4">
                            <div class="card-header">
                                <h3 class="card-title">Régler les dettes !</h3>
                            </div>
                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex align-items-center gap-3">
                                    <div class="memberName py-1">
                                        <p class="m-0">
                                            <span class="fw-bold">Utilisateur 1</span>
                                            doit
                                            <span class="text-decoration-underline">50€</span>
                                            à
                                            <span class="fw-bold">Utilisateur 2</span>
                                        </p>
                                    </div>
                                </li>
                                <!-- Ajoutez d'autres éléments de dette ici -->
                            </ul>
                        </div>
                    </div>
                </div>
                <div id="photos" class="tab-pane">
                    <div class="photo-placeholder">
                        <!-- Placeholder pour les photos -->
                        <p>Les photos seront affichées ici.</p>
                    </div>
                </div>
