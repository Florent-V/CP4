{% extends 'base.html.twig' %}

{% block title %}Modifier mon compte{% endblock %}

{% block body %}
<main class="profile-page container-md my-4">

    <!-- Header -->
    <div class="profile-header d-flex justify-content-between align-items-center">
        <a class="nav-link" href="{{ path('app_user_account') }}" title="Retour au profil">
            <twig:ux:icon name="ep:back" height="24" width="24"/>
        </a>
        <div class="d-flex flex-column align-items-center">
             <h1 class="profile-name">Modifier mon profil</h1>
        </div>
        <!-- Placeholder for alignment -->
        <div style="width: 24px;"></div>
    </div>

    <!-- Form Panel -->
    <div class="info-card">
        {{ include('user/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
    </div>

</main>
{% endblock %}
