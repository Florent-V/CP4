{% extends 'base.html.twig' %}

{% block title %}Détail: {{ splitter_category.name }}{% endblock %}

{% block body %}
<div class="admin-dashboard p-4">
    <div class="container-fluid">
        <!-- Header -->
        <div class="admin-header d-flex flex-column flex-md-row align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h2 fw-bold">{{ splitter_category.name }}</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb bg-transparent p-0 m-0">
                        <li class="breadcrumb-item"><a href="{{ path('admin_index') }}">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('admin_app_splitter_category_index') }}">Catégories de Groupe</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Détail</li>
                    </ol>
                </nav>
            </div>
            <div class="d-flex gap-2 mt-3 mt-md-0">
                <a href="{{ path('admin_app_splitter_category_index') }}" class="btn btn-light">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left me-1" viewBox="0 0 16 16"><path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z"/></svg>
                    Retour à la liste
                </a>
                <a href="{{ path('admin_app_splitter_category_edit', {'id': splitter_category.id}) }}" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-fill me-1" viewBox="0 0 16 16"><path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708l-3-3zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207l6.5-6.5zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.499.499 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11l.178-.178z"/></svg>
                    Modifier
                </a>
            </div>
        </div>

        <!-- Content Panel -->
        <div class="admin-content-panel">
            <dl class="row">
                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9"><span class="fw-bold">#{{ splitter_category.id }}</span></dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">{{ splitter_category.name }}</dd>

                <dt class="col-sm-3">Icon</dt>
                <dd class="col-sm-9"><code>{{ splitter_category.icon }}</code></dd>

                <dt class="col-sm-3">Icon Preview</dt>
                <dd class="col-sm-9">
                    <twig:ux:icon name="{{ splitter_category.icon }}" height="50" width="50" />
                </dd>
            </dl>
        </div>

        <div class="mt-4">
             {{ include('admin/splitter_category/_delete_form.html.twig') }}
        </div>
    </div>
</div>
{% endblock %}
