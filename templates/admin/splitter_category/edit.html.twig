{% extends 'base.html.twig' %}

{% block title %}Modifier: {{ splitter_category.name }}{% endblock %}

{% block body %}
<div class="admin-dashboard p-4">
    <div class="container-fluid">
        <!-- Header -->
        <div class="admin-header d-flex flex-column flex-md-row align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h2 fw-bold">Modifier <span class="text-muted">{{ splitter_category.name }}</span></h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb bg-transparent p-0 m-0">
                        <li class="breadcrumb-item"><a href="{{ path('admin_index') }}">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('admin_app_splitter_category_index') }}">Catégories de Groupe</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Modifier</li>
                    </ol>
                </nav>
            </div>
        </div>

        <!-- Content Panel -->
        <div class="admin-content-panel">
            {{ include('admin/splitter_category/_form.html.twig', {button_label: 'Mettre à jour'}) }}
        </div>
    </div>
</div>
{% endblock %}
