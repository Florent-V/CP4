{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block body %}
<div class="admin-dashboard p-4">
    <div class="container-fluid">
        <!-- Header -->
        <div class="admin-header d-flex flex-column flex-md-row align-items-center justify-content-between mb-4">
            <div>
                <h1 class="h2 fw-bold">Gestion des Utilisateurs</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb bg-transparent p-0 m-0">
                        <li class="breadcrumb-item"><a href="{{ path('admin_index') }}">Dashboard</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Utilisateurs</li>
                    </ol>
                </nav>
                <p class="text-muted mb-0">Total : {{ users.getTotalItemCount }}</p>
            </div>
            {# <a href="#" class="btn btn-primary mt-3 mt-md-0"> ... Bouton Créer ... </a> #}
        </div>

        <!-- Search Panel -->
        <div class="admin-content-panel mb-4">
            {{ form_start(form) }}
            <div class="row g-2 align-items-end">
                <div class="col-md">
                    {{ form_row(form.search) }}
                </div>
                <div class="col-md-auto">
                    <button class="btn btn-light w-100">Rechercher</button>
                </div>
            </div>
            {{ form_end(form) }}
        </div>

        <!-- Content Panel -->
        <div class="admin-content-panel">
            <div class="table-responsive">
                <table class="table table-hover admin-table">
                    <thead>
                        <tr>
                            <th>{{ knp_pagination_sortable(users, 'Id', 'u.id') }}</th>
                            <th{% if users.isSorted('u.email') %} class="sorted"{% endif %}>
                                {{ knp_pagination_sortable(users, 'Email', 'u.email') }}
                            </th>
                            <th>Rôles</th>
                            <th>Pseudo</th>
                            <th>Vérifié ?</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for user in users %}
                        <tr>
                            <td><span class="fw-bold">#{{ user.id }}</span></td>
                            <td>{{ user.email }}</td>
                            <td>
                                {% for role in user.roles %}
                                    <span class="badge bg-info-subtle text-info-emphasis rounded-pill">{{ role }}</span>
                                {% endfor %}
                            </td>
                            <td>{{ user.pseudo }}</td>
                            <td>
                                {% if user.isVerified %}
                                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill">Oui</span>
                                {% else %}
                                    <span class="badge bg-warning-subtle text-warning-emphasis rounded-pill">Non</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="action-buttons">
                                    <a href="{{ path('admin_app_user_show', {'id': user.id}) }}" class="btn btn-sm btn-icon" title="Voir">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16"><path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/><path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/></svg>
                                    </a>
                                    <a href="{{ path('admin_app_user_edit', {'id': user.id}) }}" class="btn btn-sm btn-icon" title="Modifier">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16"><path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708l-3-3zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207l6.5-6.5zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.499.499 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11l.178-.178z"/></svg>
                                    </a>
                                    <div class="d-inline-block" title="Supprimer">
                                        {{ include('admin/user/_delete_form.html.twig') }}
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <p class="mb-0 text-muted">Aucun utilisateur trouvé.</p>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if users.pageCount > 1 %}
                <div class="d-flex justify-content-center mt-4">
                    {{ knp_pagination_render(users) }}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
